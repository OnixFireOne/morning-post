# флаг обязателен: без него снапшота в `window` не будет
# на время отладки до мержа: http://localhost:3000/?snapshot=1
SITE_URL=https://inp.one/?snapshot=1
CHART_SELECTOR="#hot-coins-chart"
# тот же бот, что у news-radar
TELEGRAM_BOT_TOKEN=
# на старте — личный chat_id владельца, позже — id канала
TELEGRAM_TARGET_CHAT_ID=
# личный chat_id: алерты и ошибки, всегда
TELEGRAM_ADMIN_CHAT_ID=
# пост всегда в 09:00 МСК
TZ=Europe/Moscow
STATE_FILE=./data/state.json
# вечный журнал дней — append-only, без ротации (в отличие от state.json,
# который хранит только последние ~60 дней). Полный Facts за каждый день,
# пока никто не читает — для будущего анализа
FACTS_LOG_FILE=./data/facts.jsonl
MIN_SWARM_SIZE=20

# --- v2: генерация абзацев моделью (см. plan/ai-start-integration.md) ---
# аварийный выключатель прода — отключено, не включать без ручной обкатки
# со всеми фикстурами (раздел 9). Режим (сухой/боевой, реальный запрос к
# модели вне боя) задаётся только флагами командной строки: --dry, --ai,
# --fixture=<path>, --force — см. README, таблицу команд.
AI_ENABLED=0
# 26.08: провайдер выбирается отсюда, не по URL — профили (базовый URL,
# стиль авторизации, модели по умолчанию, тарификация) теперь заведены в
# config/providers.json (02.09), не в коде — src/ai/providers.ts только
# грузит и валидирует его. Пусто = openrouter (значение по умолчанию).
# Один из ключей config/providers.json — сейчас openrouter | anthropic
AI_PROVIDER=openrouter
# 02.09: путь к альтернативному каталогу провайдеров вне репозитория — для
# правки на VPS без git pull. Пусто = встроенный config/providers.json.
# Если путь задан, но файл не читается или не проходит валидацию — старт
# падает с ошибкой, откат на встроенный каталог не происходит.
AI_PROVIDERS_FILE=
# ключ провайдера — не токен бота, отдельный секрет. Для openrouter — sk-or-v1-...
# Имя этой переменной для выбранного провайдера — поле apiKeyVar в
# config/providers.json (сейчас AI_API_KEY у обоих профилей).
AI_API_KEY=
# Переопределяют базовый URL/модели выбранного профиля, если заданы — иначе
# берутся значения профиля из providers.ts. Обычно не нужны: используются,
# если вместо реального провайдера подставляется совместимый прокси.
AI_BASE_URL=
AI_MODEL=
AI_MODEL_FALLBACK=
# json_schema у провайдера заранее неизвестен — включать флагом только после проверки на обкатке
AI_STRUCTURED_OUTPUT=0
# таймаут одного запроса, мс
AI_TIMEOUT_MS=25000
# общий бюджет на все попытки и обе модели вместе, мс
AI_TOTAL_BUDGET_MS=70000
# попыток на одну модель; ретрай только на содержательный отказ (валидатор/битый
# JSON/пустой ответ) — на таймаут, 401/404/429/5xx повтора той же моделью нет
AI_MAX_ATTEMPTS=2
# версия промпта — пишется в state.json рядом со сгенерированным текстом
PROMPT_VERSION=10

# ежедневная сводка расхода в личку: daily | weekly | 0. Единица везде —
# доллары (единственная в проекте, см. src/ai/usageReport.ts)
AI_USAGE_REPORT=daily
# баланс на дату AI_BALANCE_AS_OF, в долларах — сверяется вручную, пусто =
# блок баланса выпадает из сводки целиком, а не показывает нули. Граница при
# смене провайдера/тарифа проводится этой датой: строки usage.jsonl старше
# неё не читаются вовсе, не пересчитываются задним числом.
AI_BALANCE_START=
# дата последней сверки с панелью, YYYY-MM-DD — остаток считается от неё
AI_BALANCE_AS_OF=
# порог остатка баланса для пометки в сводке, пусто = выключено
AI_BALANCE_WARN=

# сетевой прокси для исходящих соединений AI-клиента (опционально, стандартные
# переменные) — не путать с AI_BASE_URL, это два разных прокси (раздел 2)
HTTPS_PROXY=
HTTP_PROXY=

# --- diagnostics only: read by tools/ai-probe.ts, never by src/ ---
# `npm run ai:probe` — one-shot report of how a proxy/provider actually
# behaves against Anthropic's native /messages protocol, before it goes into
# config/providers.json. Пусто = берётся AI_BASE_URL/AI_MODEL/AI_MODEL_FALLBACK
# выше (первая строка отчёта скажет, откуда взято значение).
AI_PROBE_BASE_URL=
AI_PROBE_MODEL=
AI_PROBE_MODEL_FALLBACK=
AI_PROBE_API_VERSION=
AI_PROBE_TIMEOUT_MS=
