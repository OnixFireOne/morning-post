# флаг обязателен: без него снапшота в `window` не будет
# на время отладки до мержа: http://localhost:3000/?snapshot=1
SITE_URL=https://inp.one/?snapshot=1
CHART_SELECTOR="#hot-coins-chart"
# тот же бот, что у news-radar
TELEGRAM_BOT_TOKEN=
# на старте — личный chat_id владельца, позже — id канала
TELEGRAM_TARGET_CHAT_ID=
# личный chat_id: алерты и ошибки, всегда
TELEGRAM_ADMIN_CHAT_ID=
# пост всегда в 09:00 МСК
TZ=Europe/Moscow
STATE_FILE=./data/state.json
# вечный журнал дней — append-only, без ротации (в отличие от state.json,
# который хранит только последние ~60 дней). Полный Facts за каждый день,
# пока никто не читает — для будущего анализа
FACTS_LOG_FILE=./data/facts.jsonl
DRY_RUN=0
# только для отладки
SNAPSHOT_FILE=
MIN_SWARM_SIZE=20

# --- v2: генерация абзацев моделью (см. plan/ai-start-integration.md) ---
# отключено — не включать без ручной обкатки со всеми фикстурами (раздел 9)
AI_ENABLED=0
# явный опт-ин на реальный запрос к модели при DRY_RUN=1 (раздел 3.4) — без
# него dry-run всегда идёт шаблоном, запроса нет вообще. Ставить только
# вручную для конкретного прогона обкатки, не держать включённым постоянно
AI_ALLOW_REAL_IN_DRY=0
# OpenAI-совместимый эндпоинт своего прокси, обычно оканчивается на /v1
AI_BASE_URL=
# ключ прокси — не токен бота, отдельный секрет
AI_API_KEY=
# id из GET {AI_BASE_URL}/models — не угадывать по документации Anthropic
AI_MODEL=
# резервная модель, свой id из того же списка /models
AI_MODEL_FALLBACK=
# json_schema у прокси заранее неизвестен — включать флагом только после проверки на обкатке
AI_STRUCTURED_OUTPUT=0
# таймаут одного запроса, мс
AI_TIMEOUT_MS=25000
# общий бюджет на все попытки и обе модели вместе, мс
AI_TOTAL_BUDGET_MS=70000
# попыток на одну модель; ретрай только на содержательный отказ (валидатор/битый
# JSON/пустой ответ) — на таймаут, 401/404/429/5xx повтора той же моделью нет
AI_MAX_ATTEMPTS=2
# версия промпта — пишется в state.json рядом со сгенерированным текстом
PROMPT_VERSION=4
# цена за 1M входных/выходных токенов основной модели, пусто = стоимость не считается
AI_PRICE_IN=
AI_PRICE_OUT=
# то же для резервной модели отдельно — Opus дороже Sonnet в разы, общий тариф
# занизит именно дни с фолбэком
AI_FALLBACK_PRICE_IN=
AI_FALLBACK_PRICE_OUT=
# порог дневного расхода токенов для алерта, пусто = выключено
AI_DAILY_TOKEN_WARN=

# ежедневная сводка расхода в личку: daily | weekly | 0
AI_USAGE_REPORT=daily
# баланс на панели прокси на дату AI_BALANCE_AS_OF — сверяется вручную,
# пусто = блок баланса выпадает из сводки целиком, а не показывает нули
AI_BALANCE_START=
# дата последней сверки с панелью, YYYY-MM-DD — остаток считается от неё
AI_BALANCE_AS_OF=
# порог остатка баланса для пометки в сводке, пусто = выключено
AI_BALANCE_WARN=

# сетевой прокси для исходящих соединений AI-клиента (опционально, стандартные
# переменные) — не путать с AI_BASE_URL, это два разных прокси (раздел 2)
HTTPS_PROXY=
HTTP_PROXY=
