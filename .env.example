SITE_URL=https://inp.one/?snapshot=1   # флаг обязателен: без него снапшота в `window` не будет
# на время отладки до мержа: http://localhost:3000/?snapshot=1
CHART_SELECTOR=#hot-coins-chart
TELEGRAM_BOT_TOKEN=           # тот же бот, что у news-radar
TELEGRAM_TARGET_CHAT_ID=      # на старте — личный chat_id владельца, позже — id канала
TELEGRAM_ADMIN_CHAT_ID=       # личный chat_id: алерты и ошибки, всегда
TZ=Europe/Moscow              # пост всегда в 09:00 МСК
STATE_FILE=./data/state.json
DRY_RUN=0
SNAPSHOT_FILE=                # только для отладки
MIN_SWARM_SIZE=20
