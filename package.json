{
  "name": "morning-post",
  "private": true,
  "version": "0.1.0",
  "description": "Daily Telegram post generated from inp.one's hot-coins snapshot.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:gen": "node tools/gen-fixtures.mjs",
    "dry": "tsx src/index.ts --dry",
    "dry:fixture": "tsx src/index.ts --dry --fixture=./fixtures/real-day.json",
    "post": "tsx src/index.ts",
    "post:force": "tsx src/index.ts --force",
    "ai:models": "tsx src/ai/listModels.ts",
    "ai:compare": "tsx tools/ai-compare.ts",
    "ai:prompt": "tsx tools/ai-prompt.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "playwright": "1.62.1",
    "tsx": "4.23.12",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
