{
  "name": "morning-post",
  "private": true,
  "version": "0.1.0",
  "description": "Daily Telegram post generated from inp.one's hot-coins snapshot.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:gen": "node tools/gen-fixtures.mjs",
    "dry": "cross-env DRY_RUN=1 tsx src/index.ts",
    "dry:fixture": "cross-env DRY_RUN=1 tsx src/index.ts",
    "post": "cross-env DRY_RUN=0 tsx src/index.ts",
    "post:force": "cross-env DRY_RUN=0 tsx src/index.ts --force"
  },
  "dependencies": {
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "playwright": "1.62.1",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
