{
  "openrouter": {
    "name": "openrouter",
    "baseUrl": "https://openrouter.ai/api/v1",
    "authStyle": "bearer",
    "apiKeyVar": "AI_API_KEY",
    "extraHeaders": {
      "HTTP-Referer": "https://github.com/morning-post",
      "X-Title": "morning-post",
      "X-OpenRouter-Metadata": "enabled"
    },
    "primaryModel": "anthropic/claude-sonnet-5",
    "fallbackModel": "anthropic/claude-opus-5",
    "costSource": "provider",
    "priceTable": {},
    "inputOverhead": 0,
    "balanceSource": "api",
    "unitRate": 1
  },
  "aiprime.messages": {
    "name": "aiprime.messages",
    "baseUrl": "https://aiprimetech.io/v1",
    "protocol": "messages",
    "maxTokens": 1024,
    "authStyle": "x-api-key",
    "apiKeyVar": "AI_API_KEY",
    "extraHeaders": {},
    "modelsPath": "/models",
    "primaryModel": "claude-sonnet-5",
    "fallbackModel": "claude-opus-5",
    "costSource": "table",
    "priceTable": {
      "claude-sonnet-5": { "priceInPerMillion": 2, "priceOutPerMillion": 10 },
      "claude-opus-5": { "priceInPerMillion": 5, "priceOutPerMillion": 25 }
    },
    "inputOverhead": 0,
    "balanceSource": "manual",
    "unitRate": 1
  },
  "aiprime.chat_completions": {
    "name": "aiprime.chat_completions",
    "baseUrl": "https://aiprimetech.io/v1",
    "protocol": "chat_completions",
    "authStyle": "bearer",
    "apiKeyVar": "AI_API_KEY",
    "extraHeaders": {},
    "modelsPath": "/models",
    "primaryModel": "claude-sonnet-5",
    "fallbackModel": "claude-opus-5",
    "costSource": "none",
    "priceTable": {},
    "inputOverhead": 0,
    "balanceSource": "manual",
    "unitRate": 1
  }
}
